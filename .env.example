DATABASE_URL=postgresql://paidahead:paidahead_local_only@127.0.0.1:54329/paidahead
DEMO_MODE=true
API_PORT=3003
# Web (apps/web) reads this file server-side only. Demo auth is ignored when NODE_ENV=production.
# WEB_CHAIN_RPC_URL=http://127.0.0.1:8545  # only if the browser wallet must use a different RPC than REGISTRATION_RPC_URL
REGISTRATION_RPC_URL=http://127.0.0.1:8545
LOCAL_DEMO_REGISTRAR=true
# For a separately configured testnet registrar, disable LOCAL_DEMO_REGISTRAR
# and supply REGISTRAR_PRIVATE_KEY through the worker environment only.
# API integration tests require a disposable database; never use production.
TEST_DATABASE_URL=postgresql://paidahead:paidahead_local_only@127.0.0.1:54329/paidahead

# Optional real AI analysis of synthetic demo documents only (server-side).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
